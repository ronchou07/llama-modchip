#!/usr/bin/env bash
# ==============================================================================
# ♟️ ./modchip — Unified CLI for 256K CPU Co-Design, RouteCrack & Stockfish-PVS v2
# ==============================================================================
# Usage:
#   ./modchip setup [args]          # Build patched llama.cpp + Stockfish-PVS & download GGUF
#   ./modchip start [model.gguf]    # Start 256K CPU Server + Web UI Gateway in background
#   ./modchip chat [-p "prompt"]    # Interactive terminal chat with live tok/s telemetry
#   ./modchip bench                 # Run 2-stage speed test & print shareable CPU scorecard
#   ./modchip eval [args]           # Run 100-pt Quality, Tool-Calling, Coding & Needle Gate
#   ./modchip quantize [args]       # Build Fractal-64 (14.35 GiB) or MXFP4 (15.95 GiB) GGUF
#   ./modchip web                   # Open Live Web Chat & Telemetry HUD (http://127.0.0.1:8787)
#   ./modchip claude [args]         # Launch Claude Code CLI wired to local CPU engine
#   ./modchip status                # Inspect live server, HugePages & /dev/shm/llama_modchip.bin
#   ./modchip tui                   # Launch interactive Curses TUI controller
#   ./modchip stop                  # Stop background server & gateway
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="${WORKSPACE_DIR:-${REPO_ROOT}/workspace}"
SERVER_PORT="${SERVER_PORT:-8789}"
GATEWAY_PORT="${GATEWAY_PORT:-8787}"
PID_DIR="${WORKSPACE_DIR}/run"
SERVER_PID_FILE="${PID_DIR}/server.pid"
GATEWAY_PID_FILE="${PID_DIR}/gateway.pid"
GATEWAY_HOST_FILE="${PID_DIR}/gateway_host"
SERVER_HOST="${SERVER_HOST:-127.0.0.1}"
if [[ -z "${GATEWAY_HOST:-}" ]] && [[ -f "$GATEWAY_HOST_FILE" ]]; then
    GATEWAY_HOST="$(head -n 1 "$GATEWAY_HOST_FILE" 2>/dev/null | tr -d '[:space:]')"
fi
GATEWAY_HOST="${GATEWAY_HOST:-127.0.0.1}"
FRACTAL_MODEL="${WORKSPACE_DIR}/models/NVIDIA-Nemotron-3.5-30B-A3B-Fractal-64.gguf"
Q4_MODEL="${WORKSPACE_DIR}/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_0.gguf"
DEFAULT_MODEL_FILE="${PID_DIR}/default_model"

resolve_default_model() {
    local saved=""
    if [[ -f "$DEFAULT_MODEL_FILE" ]]; then
        saved="$(head -n 1 "$DEFAULT_MODEL_FILE" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' || true)"
    fi
    if [[ -n "$saved" && -f "$saved" ]]; then
        printf '%s\n' "$saved"
    elif [[ -f "$FRACTAL_MODEL" ]]; then
        printf '%s\n' "$FRACTAL_MODEL"
    else
        printf '%s\n' "$Q4_MODEL"
    fi
}
DEFAULT_MODEL="$(resolve_default_model || printf '%s\n' "$Q4_MODEL")"

BOLD="\033[1m"
GREEN="\033[92m"
CYAN="\033[96m"
YELLOW="\033[93m"
RESET="\033[0m"

is_port_up() {
    local port="$1"
    local host="${2:-127.0.0.1}"
    [[ "$host" == "0.0.0.0" ]] && host="127.0.0.1"
    python3 - "$host" "$port" <<'PYEOF' 2>/dev/null
import sys, socket
host, port = sys.argv[1], int(sys.argv[2])
for h in ([host, "127.0.0.1"] if host != "127.0.0.1" else ["127.0.0.1"]):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.4)
    rc = s.connect_ex((h, port))
    s.close()
    if rc == 0:
        sys.exit(0)
sys.exit(1)
PYEOF
}

is_url_up() {
    local url="${1%/}"
    curl -sf --max-time 1 "${url}/health" >/dev/null 2>&1 || curl -sf --max-time 1 "${url}/v1/models" >/dev/null 2>&1
}

find_any_active_endpoint() {
    local cand_url="${MODCHIP_URL:-${LLAMA_API_URL:-}}"
    if [[ -n "$cand_url" ]] && is_url_up "$cand_url"; then
        echo "${cand_url%/}"
        return 0
    fi
    if [[ "$GATEWAY_HOST" != "127.0.0.1" ]] && is_port_up "$GATEWAY_PORT" "$GATEWAY_HOST"; then
        echo "http://${GATEWAY_HOST}:${GATEWAY_PORT}"
        return 0
    fi
    for p in "$GATEWAY_PORT" "$SERVER_PORT" 8080 8001; do
        if is_port_up "$p" "$GATEWAY_HOST"; then
            local h="$GATEWAY_HOST"
            [[ "$p" == "$SERVER_PORT" ]] && h="$SERVER_HOST"
            echo "http://${h}:${p}"
            return 0
        fi
    done
    if [[ -f "${HOME}/.config/modchip/remote_url" ]]; then
        local cfg_url
        cfg_url="$(head -n 1 "${HOME}/.config/modchip/remote_url" | tr -d '[:space:]')"
        if [[ -n "$cfg_url" ]] && is_url_up "$cfg_url"; then
            echo "${cfg_url%/}"
            return 0
        fi
    fi
    return 1
}

find_any_active_port() {
    for p in "$GATEWAY_PORT" "$SERVER_PORT" 8080 8001; do
        if is_port_up "$p" "$GATEWAY_HOST"; then
            echo "$p"
            return 0
        fi
    done
    return 1
}

cmd_setup() {
    case "$(uname -s)" in
        Darwin)
            exec "${REPO_ROOT}/apple-silicon/setup.sh" "$@"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "${REPO_ROOT}/windows/modchip_win.ps1" "$@"
            ;;
        *)
            exec "${REPO_ROOT}/install.sh" "$@"
            ;;
    esac
}

cmd_start() {
    local explicit_model="${1:-}"
    local model="${explicit_model:-$DEFAULT_MODEL}"
    mkdir -p "$PID_DIR" "${WORKSPACE_DIR}/logs"

    case "$(uname -s)" in
        Darwin)
            echo -e "${CYAN}[*] macOS detected — delegating to apple-silicon/ scripts...${RESET}"
            "${REPO_ROOT}/apple-silicon/run-server.sh" > "${WORKSPACE_DIR}/logs/server.log" 2>&1 &
            echo $! > "$SERVER_PID_FILE"
            "${REPO_ROOT}/apple-silicon/run-gateway.sh" > "${WORKSPACE_DIR}/logs/gateway.log" 2>&1 &
            echo $! > "$GATEWAY_PID_FILE"
            return 0
            ;;
        MINGW*|MSYS*|CYGWIN*)
            echo -e "${CYAN}[*] Windows detected — launching windows/modchip_win.ps1...${RESET}"
            exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "${REPO_ROOT}/windows/modchip_win.ps1" "$@"
            ;;
    esac

    if [[ ! -f "$model" ]]; then
        echo -e "${YELLOW}[!] Model file not found at: ${model}${RESET}"
        echo -e "    • Run ${BOLD}./modchip setup${RESET} to build & download Nemotron-3.5-30B-A3B automatically,"
        echo -e "    • Or bring your own GGUF: ${BOLD}./modchip start /path/to/your_model.gguf${RESET}"
        exit 1
    fi

    if [[ -n "$explicit_model" ]]; then
        local abs_model
        case "$model" in
            /*) abs_model="$model" ;;
            *)  abs_model="${PWD}/${model}" ;;
        esac
        model="$abs_model"
    fi

    if is_port_up "$SERVER_PORT" "$SERVER_HOST"; then
        echo -e "${GREEN}[✓] llama-server is already listening on ${SERVER_HOST}:${SERVER_PORT}${RESET}"
        if [[ -n "$explicit_model" ]]; then
            local probe_h="$SERVER_HOST"
            [[ "$probe_h" == "0.0.0.0" ]] && probe_h="127.0.0.1"
            local live_model
            live_model="$(curl -sf --max-time 1 "http://${probe_h}:${SERVER_PORT}/props" 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("model_path") or "")' 2>/dev/null || true)"
            if [[ -z "$live_model" ]]; then
                live_model="$(curl -sf --max-time 1 "http://${probe_h}:${SERVER_PORT}/v1/models" 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin); m=(d.get("data") or d.get("models") or [{}])[0]; s=(m.get("id") or m.get("name") or ""); print(s if s.lower().endswith(".gguf") else "")' 2>/dev/null || true)"
            fi
            if [[ -n "$live_model" && "$(basename "$live_model")" != "$(basename "$model")" ]]; then
                echo -e "${YELLOW}[!] Active server is currently serving $(basename "$live_model"); run './modchip restart \"${model}\"' to switch models.${RESET}"
            else
                printf '%s\n' "$model" > "$DEFAULT_MODEL_FILE"
                DEFAULT_MODEL="$model"
            fi
        fi
    else
        if [[ ! -x "${REPO_ROOT}/start_server.sh" ]]; then
            echo -e "${YELLOW}[!] start_server.sh not found. Running './modchip setup --skip-model --model $model' first...${RESET}"
            "${REPO_ROOT}/install.sh" --skip-model --model "$model"
        fi
        echo -e "${CYAN}[*] Starting 256K CPU Engine + Stockfish-PVS v2 (M=7) in background...${RESET}"
        SERVER_HOST="${SERVER_HOST}" nohup "${REPO_ROOT}/start_server.sh" "$model" > "${WORKSPACE_DIR}/logs/server.log" 2>&1 &
        echo $! > "$SERVER_PID_FILE"
        if [[ -n "$explicit_model" ]]; then
            printf '%s\n' "$model" > "$DEFAULT_MODEL_FILE"
            DEFAULT_MODEL="$model"
        fi
    fi

    local start_gw=0
    if is_port_up "$GATEWAY_PORT" "$GATEWAY_HOST"; then
        local probe_gw="$GATEWAY_HOST"
        [[ "$probe_gw" == "0.0.0.0" ]] && probe_gw="127.0.0.1"
        local disk_gw_hash live_gw_hash prev_gw_host=""
        disk_gw_hash="$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest()[:16])' "${REPO_ROOT}/gateway/sse_gateway.py" 2>/dev/null || true)"
        live_gw_hash="$(curl -s -X OPTIONS -D - -o /dev/null --max-time 2 "http://${probe_gw}:${GATEWAY_PORT}/" 2>/dev/null | awk 'tolower($1)=="x-modchip-gateway:" {gsub(/\r/,"",$2); print $2; exit}' || true)"
        if [[ -f "$GATEWAY_HOST_FILE" ]]; then
            prev_gw_host="$(head -n 1 "$GATEWAY_HOST_FILE" 2>/dev/null | tr -d '[:space:]' || true)"
        fi
        if [[ -n "$disk_gw_hash" && "$live_gw_hash" != "$disk_gw_hash" ]] || [[ -n "$prev_gw_host" && "$prev_gw_host" != "$GATEWAY_HOST" ]]; then
            local gw_pid="" gw_comm=""
            if command -v lsof >/dev/null 2>&1; then
                gw_pid="$(lsof -nP -t -iTCP:"$GATEWAY_PORT" -sTCP:LISTEN 2>/dev/null | head -n 1 || true)"
            elif command -v ss >/dev/null 2>&1; then
                gw_pid="$(ss -Hltnp "sport = :$GATEWAY_PORT" 2>/dev/null | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -n 1 || true)"
            fi
            if [[ -z "$gw_pid" && -f "$GATEWAY_PID_FILE" ]]; then
                gw_pid="$(cat "$GATEWAY_PID_FILE" 2>/dev/null | tr -d '[:space:]' || true)"
            fi
            if [[ -n "$gw_pid" ]]; then
                gw_comm="$(ps -o comm= -p "$gw_pid" 2>/dev/null | tr -d '[:space:]' || true)"
                gw_comm="${gw_comm##*/}"
            fi
            if [[ -n "$gw_pid" ]] \
               && [[ "$(ps -o uid= -p "$gw_pid" 2>/dev/null | tr -d '[:space:]')" == "$(id -u)" ]] \
               && [[ "$gw_comm" =~ ^[Pp]ython ]] \
               && ps -o args= -p "$gw_pid" 2>/dev/null | grep -qF "${REPO_ROOT}/gateway/sse_gateway.py"; then
                echo -e "${CYAN}[*] Reloading sse_gateway.py (pid ${gw_pid}) to apply updated gateway code/config...${RESET}"
                kill "$gw_pid" 2>/dev/null || true
                for _ in $(seq 1 50); do
                    is_port_up "$GATEWAY_PORT" "$GATEWAY_HOST" || break
                    sleep 0.1
                done
                if ! is_port_up "$GATEWAY_PORT" "$GATEWAY_HOST"; then
                    start_gw=1
                else
                    echo -e "${YELLOW}[!] Gateway pid ${gw_pid} did not exit cleanly; run './modchip stop' to force-restart.${RESET}"
                fi
            else
                echo -e "${GREEN}[✓] Agentic SSE Gateway & Web HUD already listening on http://${GATEWAY_HOST}:${GATEWAY_PORT}${RESET}"
            fi
        else
            echo -e "${GREEN}[✓] Agentic SSE Gateway & Web HUD already listening on http://${GATEWAY_HOST}:${GATEWAY_PORT}${RESET}"
        fi
    else
        start_gw=1
    fi
    if [[ "$start_gw" -eq 1 ]]; then
        export LLAMA_BACKEND_URL="http://${SERVER_HOST}:${SERVER_PORT}"
        export GATEWAY_HOST="${GATEWAY_HOST}"
        export GATEWAY_PORT="${GATEWAY_PORT}"
        echo "${GATEWAY_HOST}" > "$GATEWAY_HOST_FILE"
        nohup python3 "${REPO_ROOT}/gateway/sse_gateway.py" "${GATEWAY_PORT}" > "${WORKSPACE_DIR}/logs/gateway.log" 2>&1 &
        echo $! > "$GATEWAY_PID_FILE"
    fi

    local probe_server_host="$SERVER_HOST"
    [[ "$probe_server_host" == "0.0.0.0" ]] && probe_server_host="127.0.0.1"
    echo -ne "${CYAN}[*] Waiting for model weights to load & AVX-512/AVX2 repacking (logs: workspace/logs/server.log)...${RESET}"
    for _ in $(seq 1 90); do
        if curl -sf "http://${probe_server_host}:${SERVER_PORT}/health" >/dev/null 2>&1; then
            echo -e " ${GREEN}${BOLD}READY!${RESET}"
            break
        fi
        echo -n "."
        sleep 1
    done
    echo ""

    echo -e "${BOLD}${GREEN}╔══════════════════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${GREEN}║ ♟️  llama-modchip v2.4.0 is LIVE! Choose how you want to interact:           ║${RESET}"
    echo -e "${BOLD}${GREEN}╠══════════════════════════════════════════════════════════════════════════════╣${RESET}"
    echo -e "  🌐 ${BOLD}Live Web Chat & Telemetry HUD${RESET} : ${CYAN}http://${GATEWAY_HOST}:${GATEWAY_PORT}${RESET}"
    echo -e "  💬 ${BOLD}Interactive Terminal Chat${RESET}     : ${GREEN}./modchip chat${RESET}"
    echo -e "  📊 ${BOLD}Run 2-Stage Speed Benchmark${RESET}   : ${GREEN}./modchip bench${RESET}"
    echo -e "  🤖 ${BOLD}Launch Claude Code Agent CLI${RESET}  : ${GREEN}./modchip claude${RESET}"
    echo -e "  🛑 ${BOLD}Stop Background Services${RESET}      : ${YELLOW}./modchip stop${RESET}"
    echo -e "${BOLD}${GREEN}╚══════════════════════════════════════════════════════════════════════════════╝${RESET}"
}

cmd_stop() {
    local stopped=0
    for pf in "$GATEWAY_PID_FILE" "$SERVER_PID_FILE"; do
        if [[ -f "$pf" ]]; then
            local pid
            pid="$(cat "$pf" 2>/dev/null || true)"
            if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null || true
                stopped=1
            fi
            rm -f "$pf"
        fi
    done
    rm -f "$GATEWAY_HOST_FILE"
    local esc_repo
    esc_repo="$(printf '%s' "$REPO_ROOT" | sed 's/[][\.*^$+?(){}|]/\\&/g')"
    pkill -u "$(id -u)" -f "llama-server-nemotron" 2>/dev/null && stopped=1 || true
    pkill -u "$(id -u)" -f "(^|/)[Pp]ython[0-9.]* .*${esc_repo}/gateway/sse_gateway\.py" 2>/dev/null && stopped=1 || true
    if [[ "$stopped" -eq 1 ]]; then
        echo -e "${GREEN}[✓] Stopped llama-server and sse_gateway.${RESET}"
    else
        echo -e "${YELLOW}[i] No running background instances found.${RESET}"
    fi
}

cmd_status() {
    python3 "${REPO_ROOT}/scripts/check_cpu_readiness.py"
    echo ""
    local ep
    if ep="$(find_any_active_endpoint)"; then
        echo -e "${GREEN}${BOLD}[ONLINE]${RESET} Active inference endpoint detected on ${CYAN}${ep}${RESET}"
        local active_model
        active_model="$(curl -sf --max-time 1 "${ep}/v1/models" 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin); m=(d.get("data") or d.get("models") or [{}])[0]; print(m.get("id") or m.get("name") or "")' 2>/dev/null || true)"
        if [[ -n "$active_model" ]]; then
            echo -e "${GREEN}${BOLD}[MODEL]${RESET}  ${BOLD}${active_model}${RESET}"
        fi
        if is_port_up "$GATEWAY_PORT" "$GATEWAY_HOST"; then
            echo -e "${GREEN}${BOLD}[WEB UI]${RESET} Live Web Chat & Telemetry HUD: ${CYAN}http://${GATEWAY_HOST}:${GATEWAY_PORT}${RESET}"
        fi
    else
        echo -e "${YELLOW}[OFFLINE]${RESET} No active server detected. Run ${BOLD}./modchip start${RESET} to launch."
    fi
}

ensure_ready_and_running() {
    if find_any_active_endpoint >/dev/null; then
        return 0
    fi
    if [[ "$(uname -s)" == "Darwin" ]]; then
        if [[ ! -f "${REPO_ROOT}/apple-silicon/.setup_done" ]] && ! command -v llama-server >/dev/null 2>&1; then
            echo -e "${CYAN}[*] First run on macOS — running apple-silicon/setup.sh...${RESET}"
            "${REPO_ROOT}/apple-silicon/setup.sh"
        fi
        cmd_start "$@"
        return 0
    fi
    if [[ ! -f "$DEFAULT_MODEL" ]] || [[ ! -x "${WORKSPACE_DIR}/bin/llama-server-nemotron" ]]; then
        echo -e "${CYAN}[*] First run detected — building patched engine & downloading model automatically...${RESET}"
        "${REPO_ROOT}/install.sh"
        DEFAULT_MODEL="$(resolve_default_model)"
    fi
    cmd_start
}

cmd_web() {
    local url
    if ! url="$(find_any_active_endpoint)"; then
        ensure_ready_and_running "$@"
        url="http://${GATEWAY_HOST}:${GATEWAY_PORT}"
    fi
    echo -e "${GREEN}[*] Opening Live Web Chat & Telemetry HUD at ${CYAN}${url}${RESET}"
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 || true
    elif command -v open >/dev/null 2>&1; then
        open "$url" >/dev/null 2>&1 || true
    fi
}

cmd_chat() {
    ensure_ready_and_running
    exec python3 "${REPO_ROOT}/scripts/chat.py" "$@"
}

cmd_bench() {
    ensure_ready_and_running
    exec python3 "${REPO_ROOT}/scripts/chat.py" --bench "$@"
}

cmd_eval() {
    ensure_ready_and_running
    exec python3 "${REPO_ROOT}/benchmarks/eval_quality_and_tools.py" "$@"
}

cmd_quantize() {
    exec "${REPO_ROOT}/scripts/build_fractal_moe_gguf.sh" "$@"
}

cmd_claude() {
    local ep
    if ! ep="$(find_any_active_endpoint)"; then
        ensure_ready_and_running
        ep="http://${GATEWAY_HOST}:${GATEWAY_PORT}"
    fi
    export ANTHROPIC_BASE_URL="${ep}"
    local api_key="${VEX_API_KEY:-not-needed}"
    case "$ep" in
        http://127.0.0.1*|http://localhost*) ;;
        *) api_key="not-needed"; echo "warning: endpoint $ep is not local; API key not sent" >&2 ;;
    esac
    export ANTHROPIC_API_KEY="$api_key"
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    export DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
    unset ANTHROPIC_AUTH_TOKEN 2>/dev/null || true
    unset CLAUDE_CODE_USE_VERTEX 2>/dev/null || true
    unset CLAUDE_CODE_USE_BEDROCK 2>/dev/null || true

    local raw_model model_id model_banner
    raw_model="$(curl -sf --max-time 1 "${ep}/v1/models" 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin); m=(d.get("data") or d.get("models") or [{}])[0]; print(m.get("id") or m.get("name") or "")' 2>/dev/null || true)"
    if [[ "$raw_model" == *[Dd]eep[Ss]eek* ]]; then
        model_id="DeepSeek-V4-Flash-0731-Fractal-284B"
        model_banner="DeepSeek-V4-Flash-0731-Fractal (284B-A10B MoE · 1.56-bit Fractal · 64GB CPU)"
    elif [[ "$raw_model" == *[Nn]emotron* ]]; then
        model_id="NVIDIA-Nemotron-3.5-30B-A3B-Fractal-64"
        model_banner="NVIDIA-Nemotron-3.5-30B-A3B-Fractal-64 (30B-A3B Hybrid Mamba-2 · 256K CPU)"
    elif [[ -n "$raw_model" ]]; then
        model_id="$(basename "$raw_model" .gguf | sed -E 's/-00001-of-[0-9]+$//')"
        model_banner="$model_id"
    else
        model_id="DeepSeek-V4-Flash-0731-Fractal-284B"
        model_banner="DeepSeek-V4-Flash-0731-Fractal (284B-A10B MoE · 64GB CPU)"
    fi

    local extra_flags=(
        --setting-sources "user"
        --model "${model_id}"
        --tools default
        --system-prompt "You are Claude Code, an interactive software engineering and security research agent."
    )

    echo -e "${GREEN}[*] Launching Claude Code — ${BOLD}${model_banner}${RESET}"
    echo -e "${GREEN}    Endpoint: ${CYAN}${ANTHROPIC_BASE_URL}${RESET} ${GREEN}(Slot-0 + HARP-Cache Warm Restore active)${RESET}"
    exec claude "${extra_flags[@]}" "$@"
}

cmd_tui() {
    local model="${1:-$DEFAULT_MODEL}"
    exec python3 "${REPO_ROOT}/scripts/llama_modchip.py" --model "$model" --tui
}

cmd_help() {
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

SUBCMD="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$SUBCMD" in
    setup|install)   cmd_setup "$@" ;;
    start|up|run)    cmd_start "$@" ;;
    stop|down)       cmd_stop ;;
    restart)         cmd_stop; cmd_start "$@" ;;
    chat|ask)        cmd_chat "$@" ;;
    bench|benchmark) cmd_bench "$@" ;;
    eval|gate)       cmd_eval "$@" ;;
    quantize|fractal) cmd_quantize "$@" ;;
    web|ui)          cmd_web "$@" ;;
    claude)          cmd_claude "$@" ;;
    status|info)     cmd_status ;;
    tui)             cmd_tui "$@" ;;
    -h|--help|help)  cmd_help ;;
    *)
        echo -e "${YELLOW}[!] Unknown command: ${SUBCMD}${RESET}"
        cmd_help
        exit 1
        ;;
esac
